{
  "name": "shru-design-system",
  "version": "0.6.4",
  "description": "A React component library built with Tailwind CSS",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "scripts/init.js",
    "scripts/copy-tokens.js",
    "scripts/tailwind.preset.cjs",
    "scripts/tokens",
    "scripts/lib"
  ],
  "scripts": {
    "dev": "npm run dev --prefix ./test",
    "build": "node scripts/copy-tokens.js && rm -rf dist && tsup && node scripts/dev/copy-styles.js",
    "check": "node scripts/dev/check.js",
    "check:metadata": "node scripts/dev/check-metadata-props.js",
    "check:unused-props": "node scripts/dev/check-unused-props.js",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run check",
    "postinstall": "node scripts/init.js || true"
  },
  "bin": {
    "shru-design-system-init": "scripts/init.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tailwind-preset": "./scripts/tailwind.preset.cjs",
    "./scripts/lib/rawColorPattern.cjs": "./scripts/lib/rawColorPattern.cjs"
  },
  "peerDependencies": {
    "@radix-ui/react-slider": "^1.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "input-otp": "^1.0.0",
    "lucide-react": "^0.400.0",
    "react": ">=18 <20",
    "react-dom": ">=18 <20",
    "react-resizable-panels": "^2.0.0",
    "tailwind-merge": "^2.0.0"
  },
  "devDependencies": {
    "@radix-ui/react-slider": "^1.2.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.2.65",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/parser": "^8.19.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.4.23",
    "axe-core": "^4.14.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "input-otp": "^1.4.2",
    "jsdom": "^27.0.1",
    "lucide-react": "^0.400.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-resizable-panels": "^2.1.7",
    "tailwind-merge": "^2.2.0",
    "tailwindcss": "^3.4.19",
    "tsup": "^8.5.1",
    "typescript": "^5.5.3",
    "vitest": "^3.2.7"
  },
  "license": "MIT",
  "author": "Shruti Goel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shru-6/my-design.git"
  },
  "homepage": "https://github.com/shru-6/my-design#readme",
  "bugs": {
    "url": "https://github.com/shru-6/my-design/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "react",
    "components",
    "design-system",
    "tailwind",
    "ui-components"
  ]
}
